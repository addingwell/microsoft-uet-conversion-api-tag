const sendHttpRequest = require('sendHttpRequest');
const JSON = require('JSON');
const eventData = require('getAllEventData')();
const currentTimestamp = require('getTimestampMillis')();
const sendPixelFromBrowser = require('sendPixelFromBrowser');
const generateRandom = require('generateRandom');
const Math = require('Math');
const log = require('logToConsole');
const sha256Sync = require('sha256Sync');
const getCookieValues = require('getCookieValues');
const setCookie = require('setCookie');
const parseUrl = require('parseUrl');
const makeTableMap = require('makeTableMap');
const Object = require('Object');
const encodeUriComponent = require('encodeUriComponent');
const encodeUri = require('encodeUri');

const api_endpoint = "https://capi.uet.microsoft.com";
const api_version = "v1";
const parsedPageLocation = parseUrl(eventData.page_location);
const clickId = getClickId();

if(clickId) {
  setCookie('FPMSCLKID', clickId, {
    httpOnly: true,
    secure: true,
    domain: 'auto',
    'max-age': 7776000,
    path: '/'
  });
}

if((eventData.client_id || eventData.user_id) && data.sendPixelRequest) {
  sendIDSyncBeacon();
}

let event = {};

event.eventType = data.eventTypeSetupMethod == "inherit" ? (eventData.event_name == 'page_view' ? 'pageLoad' : 'custom') : 'custom';

if(event.eventType == 'custom') {
  event.eventName = data.customEventName || eventData.event_name;
}

event.eventId = generateEventId();
event.eventTime = Math.floor(currentTimestamp / 1000);
event.eventSourceUrl = eventData.page_location;
event.referrerUrl = eventData.page_referrer;
event.pageTitle = eventData.page_title;
event.adStorageConsent = getAdStorageConsent();
event.userData = getUserData();
event.customData = getCustomData();

if(data.serverEventDataList) {
  data.serverEventDataList.forEach(d => {
    event[d.name] = d.value;
  });
}

const requestBody = {
  data: [event]
};

sendHttpRequest(encodeUri(api_endpoint + '/' + api_version + '/' + data.uetTagId + '/events'), (statusCode, headers, body) => {
  if(statusCode >= 200 && statusCode < 300) {
    data.gtmOnSuccess();
  } else {
    data.gtmOnFailure();
  }
}, {
  headers: {
    Authorization: 'Bearer ' + data.apiToken,
    'Content-Type': 'application/json' 
  },
  method: 'POST'
}, JSON.stringify(requestBody));


function getAdStorageConsent() {
  
  if(data.adStorageConsent == 'not_set') {
    return undefined;
  } 
  
  let consent = 'D';
  
  if(data.adStorageConsent == 'gcm') {
    
    const gcs = eventData['x-ga-gcs'];
  
    if(gcs == 'G111' || gcs == 'G110') {
      consent = 'G';
    }
  
  } 
  
  if(data.adStorageConsent != 'gcm' && data.adStorageConsent != 'not_set') {
    consent = data.adStorageConsent;
  }
 
  return consent;

}

function getUserData() {
  
  let userData = {};
  
  userData.clientUserAgent = eventData.user_agent;
  userData.anonymousId = eventData.client_id;  
  userData.externalId = eventData.user_id;
  userData.clientIpAddress = eventData.ip_override;
  userData.em = getEmailNormalizedAndHashed();
  userData.ph = getPhoneNormalizedAndHashed();
  userData.msclkid = clickId;
  
  const device_id = eventData['x-ga-resettable_device_id'];
  const platform = eventData['x-ga-platform'];
  
  if(device_id && platform) {
    userData[platform === 'ios' ? 'idfa' : 'gaid'] = device_id;
  }
  
  if(data.userDataList) {
    data.userDataList.forEach(d => {
      if(d.name == 'em') {
        userData[d.name] = getEmailNormalizedAndHashed(d.value);
      } else if(d.name == 'ph') {
        userData[d.name] = getPhoneNormalizedAndHashed(d.value);
      } else {
        userData[d.name] = d.value;
      }
    });
  }
  
  return userData;
  
}

function getPhoneNormalizedAndHashed(phoneNumber) {
                                     
  let phone;
  
  if(eventData.user_data && (eventData.user_data.phone_number || eventData.user_data.sha256_phone_number)) {
    phone = eventData.user_data.phone_number;
  }
  
  if(phoneNumber) {
    phone = phoneNumber;
  }
  
  if(phone && phone.indexOf('+') == -1) {
    log('Warning: Phone number is not E.164 formatted.');
  }
  
  return phone ? hashData(phone) : undefined;
  
}

function getEmailNormalizedAndHashed(emailAddress) {
  
  let email;
  
  if(eventData.user_data) {
      email = eventData.user_data.email_address || eventData.user_data.email || eventData.user_data.sha256_email_address;
  }
  
  if(emailAddress) {
    email = emailAddress;
  }
  
  if(email) {
  
    const atIndex = email.indexOf('@');
  
    if (atIndex === -1) {
      return email;
    }
  
    let userPart = email.substring(0, atIndex);
    const domainPart = email.substring(atIndex);
 
    const plusIndex = userPart.indexOf('+');
    if (plusIndex !== -1) {
      userPart = userPart.substring(0, plusIndex);
    }
 
    const userWithoutDots = userPart.split('.').join('');
  
    email = userWithoutDots + domainPart;
    
  }
  
  if(data.emailAddress) {
    email = data.emailAddress;
  }
  
  return email ? hashData(email) : undefined;
  
}

function getClickId() {
  
  let clickId;
  
  if(getCookieValues('FPMSCLKID')[0]) {
    clickId = getCookieValues('FPMSCLKID')[0];
  }
  
  if(parsedPageLocation.searchParams && parsedPageLocation.searchParams.msclkid) {
    clickId = parsedPageLocation.searchParams.msclkid;
  }
  
  return clickId;
  
}

function getCustomData() {
  
  let customData = {};
  
  customData.eventCategory = data.eventCategory;
  customData.eventLabel = data.eventLabel;
  customData.eventValue = data.eventValue || eventData.value;

  if(eventData.event_name == 'search' || eventData.event_name == 'view_search_results') {
    customData.searchTerm = eventData.search_term;
  }

  customData.transactionId = eventData.transaction_id;
  customData.value = eventData.value;
  customData.currency = eventData.currency;
  customData.items = getItems();
  customData.itemIds = getItemIds();
  customData.pageType = getPageType();

  customData.ecommTotalValue = eventData.value;
  customData.hotelData = getHotelData();
  
  if(data.customDataList) {
    data.customDataList.forEach(d => {
      customData[d.name] = d.value;
    });
  }

  return customData;
}

function getItems() {
 
  let items;
  
  if(eventData.items) {
    
    items = [];
    
    eventData.items.forEach(item => {
      items.push({
        id: item[getItemField('item_id')],
        quantity: item[getItemField('quantity')],
        price: item[getItemField('price')],
        name: item[getItemField('item_name')]
      });
    });
  
  }
  
  return items;
}

function getItemIds() {
  
  let item_ids;
  
  if(eventData.items) {
    
    item_ids = [];
    
    eventData.items.forEach(item => {
      item_ids.push(item[getItemField('item_id')]);
    });
  
  }
  
  return item_ids;
  
}

function getPageType() {
  
  let pageType = {
    view_cart: 'cart',
    view_item_list: 'category',
    view_item: 'product',
    search: 'searchresults',
    view_search_results: 'searchresults',
    purchase: 'purchase'    
  };
  
  if(pageType[eventData.event_name]) {
    pageType = pageType[eventData.event_name];
  } else {
    pageType = 'other';
  }
  
  return pageType;
}

function getHotelData() {
  
  let hotelData;
  
  if(data.hotelDataList) {
    hotelData = makeTableMap(data.hotelDataList, 'name', 'value');
  }
  
  return hotelData;
}

function getItemField(defaultField) {
  let result = defaultField;

  const map = {
    item_id: 'item_id',
    price: 'price',
    quantity: 'quantity',
    item_name: 'item_name'
  };

  if (data.itemsDataList) {
    data.itemsDataList.forEach(d => {
      if (map[defaultField] === d.name) {
        result = d.field;
      }
    });
  }

  return result;
}

function sendIDSyncBeacon() {

  const ids = { 
    vid: eventData.client_id,
    uid: eventData.user_id,
    Red3: "BACID_" + data.microsoftAccountId
  };
  
  if(data.userDataList) {
    
    const userDataList = makeTableMap(data.userDataList, 'name', 'value');
    
    if(userDataList.externalId) {
      ids.uid = userDataList.externalId;
    }
    if(userDataList.anonymousId) {
      ids.vid = userDataList.anonymousId;
    }
  }
  
  const queryString = Object.keys(ids)
    .filter(key => ids[key] != undefined && ids[key] != '' && ids[key] != 'undefined')
    .map(key => encodeUriComponent(key) + '=' + encodeUriComponent(ids[key]))
    .join('&');
  
  sendPixelFromBrowser('https://c.bing.com/c.gif?' + queryString);
  
}

// UTILS
function generateEventId() {
  return currentTimestamp + '.' + generateRandom(1000000000, 2147483647);
}

function isAlreadyHashed(input){
  return input && (input.toString().match('^[A-Fa-f0-9]{64}$') != null);
}

function hashData(input){
  if(input == null || isAlreadyHashed(input)){
    return input;
  }

  return sha256Sync(input.toString(), {outputEncoding: 'hex'});
}


